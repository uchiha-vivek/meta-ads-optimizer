# ---------------------------------------------------------------------------
# meta-optimizer — environment configuration template
#
# Copy this file to `.env` and fill in the required values:
#
#     cp .env.example .env
#
# `.env` holds live credentials and MUST NOT be committed to version control.
# This file is the authoritative catalog of every variable the application
# reads; `app/config/settings.py` must expose exactly these names and nothing
# else, because configuration is sourced only from the environment.
#
# Variables marked REQUIRED have no default and the application will refuse to
# start without them. Every other variable has a working default, shown as the
# value below.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Meta Marketing API credentials
# ---------------------------------------------------------------------------

# REQUIRED. Long-lived user or system-user access token used as the Bearer
# credential on every Marketing API request. The token must carry the
# `ads_read` scope for read commands, and additionally `ads_management` for
# `meta optimize` to apply changes. Generate a system user token from
# Business Manager rather than a user token: user tokens expire in 60 days,
# system user tokens do not.
META_ACCESS_TOKEN=

# REQUIRED. Numeric ID of the Meta app the token was issued for. Used to scope
# the token and to build the `appsecret_proof` request signature.
META_APP_ID=

# REQUIRED. Client secret of the same Meta app. Used solely to compute the
# HMAC-SHA256 `appsecret_proof` parameter that Meta requires on server-side
# calls. Treat this with the same care as the access token; it is never logged.
META_APP_SECRET=

# REQUIRED. Default ad account targeted by commands when `--account-id` is not
# passed. Must include the `act_` prefix, e.g. `act_123456789012345`.
META_AD_ACCOUNT_ID=

# Graph API version used to build request URLs, e.g. `v23.0`. Meta publishes a
# new version roughly quarterly and retires each after about two years; verify
# this against the Graph API changelog before deploying. Pinning it explicitly
# means an upstream version bump can never change behaviour without a
# deliberate configuration change.
META_API_VERSION=v23.0

# Base URL of the Graph API. Overridable so that tests and local development
# can point the client at a mock server without touching application code.
META_API_BASE_URL=https://graph.facebook.com


# ---------------------------------------------------------------------------
# Meta Marketing API client behaviour
# ---------------------------------------------------------------------------

# Per-request timeout in seconds, applied to both connect and read phases. A
# request exceeding this is aborted and raised as a client error rather than
# hanging the CLI indefinitely.
META_REQUEST_TIMEOUT_SECONDS=30

# Number of retry attempts for transient failures (connection errors, HTTP 5xx,
# and HTTP 429) after the initial attempt. Set to 0 to disable retries.
META_MAX_RETRIES=3

# Base delay in seconds for exponential backoff between retries. Attempt N waits
# approximately `backoff * (2 ** (N - 1))` seconds before retrying.
META_RETRY_BACKOFF_SECONDS=1.0

# How long to pause, in seconds, when Meta reports that the application has
# exhausted its rate limit budget for an ad account. Meta's throttling window
# is measured in minutes, so a short backoff simply burns retry attempts.
META_RATE_LIMIT_PAUSE_SECONDS=60


# ---------------------------------------------------------------------------
# PostgreSQL
#
# The `postgres` service in docker-compose.yml consumes the three POSTGRES_*
# variables to create the role and database on first boot. DATABASE_URL must
# stay consistent with them; the host is the Compose service name, not
# localhost, because the application connects over the Compose network.
# ---------------------------------------------------------------------------

POSTGRES_USER=meta
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=meta_optimizer

# Host port that the database is published on. Change this if 5432 is already
# in use on the host machine; it does not affect the in-network port.
POSTGRES_HOST_PORT=5432

# SQLAlchemy connection URL. The `postgresql+psycopg` scheme selects the
# psycopg 3 driver, which is the dialect SQLAlchemy 2.0 actively maintains.
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above.
DATABASE_URL=postgresql+psycopg://meta:change-me-in-production@postgres:5432/meta_optimizer

# Emit every SQL statement to the logger. Useful when debugging a repository;
# far too noisy for normal use and never enabled in production.
DATABASE_ECHO_SQL=false

# Number of connections held open in the pool.
DATABASE_POOL_SIZE=5

# Additional connections the pool may open beyond DATABASE_POOL_SIZE under
# burst load. These are discarded once returned rather than kept open.
DATABASE_MAX_OVERFLOW=10


# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Root log level. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Log output format. `console` renders human-readable records through Rich for
# interactive use; `json` emits one structured object per line for shipping to
# a log aggregator in production.
LOG_FORMAT=console
